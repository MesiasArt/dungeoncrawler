      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: "Pues me gustar\xEDa encontrar al menos una."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: PRAYMAN
      text: No te preocupes. Todo va a estar bien.
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: "\xBFC\xF3mo puedes estar tan seguro?"
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: PRAYMAN
