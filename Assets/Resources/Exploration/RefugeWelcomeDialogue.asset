      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: "TOADAV\xCDA"
      text: "\xA1Y bienvenido al refugio!"
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
