      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: PRAYMAN
      text: "Digamos que alguien me lo prometi\xF3."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: SOLID GUARDA
      text: "Bueno, ya tendremos tiempo de hablar. Por ahora, qu\xE9date dentro de
