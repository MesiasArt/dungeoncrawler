    giftId: 
    giftQuantity: 0
    textPanel: 0
  refugeNodeActivate:
  - speaker: GAMERBOY
    text: Dijeron que era peligroso encenderlo...
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: GAMERBOY
    text: "Pero si encuentro otro, podr\xEDa usarlo para regresar."
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: GAMERBOY
    text: Supongo que vale la pena el riesgo.
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: SISTEMA
    text: Nodo REFUGIO activado.
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: SISTEMA
    text: Buscando destinos...
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: SISTEMA
    text: "Ning\xFAn otro nodo disponible."
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: GAMERBOY
    text: "Bueno... ya tengo c\xF3mo volver."
    giftId: 
    giftQuantity: 0
    textPanel: 0
  - speaker: GAMERBOY
    text: "Ahora solo falta encontrar ad\xF3nde ir."
    giftId: 
    giftQuantity: 0
    textPanel: 0
