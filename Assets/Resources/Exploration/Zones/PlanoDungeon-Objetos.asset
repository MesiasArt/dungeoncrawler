  - interaction: {fileID: 0}
    switchInitiallyActive: 0
    id: 5d6d25c28f8f4e3e830d4e68d3e1fec8
    displayName: Cerrojio
    kind: 0
    cell: {x: 17, y: 34}
    heading: 0
    npcCatalog: {fileID: 11400000, guid: d9cf2ec8775878a4aaa779f8deb76746, type: 2}
    npcId: centinela
    dialogue:
    - speaker: Cerrojio
      text: "Antes de seguir, f\xEDjate en los avisos de las puertas. Te indican
        si la zona del otro lado es segura."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - speaker: Cerrojio
      text: 'Verde significa que puedes respirar tranquilo: es una zona segura, sin
        encuentros.'
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - speaker: Cerrojio
      text: "Rojo significa peligro. Al cruzar puedes encontrarte con enemigos, as\xED
        que no bajes la guardia."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - speaker: Cerrojio
      text: Revisa tu vida, tus BP y tus objetos antes de entrar. Leer una puerta
        a tiempo puede evitarte una mala sorpresa.
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
