      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: "\xBFQu\xE9 clase de problemas?"
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: "Tifan\xEDa"
      text: "Dec\xEDa que las tuber\xEDas est\xE1n soltando criaturas y que algunos
        caminos ya no son seguros."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: Por fin un lugar donde empezar a buscar respuestas.
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: "Tifan\xEDa"
      text: "Habla con el gu\xEDa de Fast Travel Station. \xC9l conoce el camino."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
  - id: city.guide.pixel.v1
    locationId: city.travel
    requireAllLocationsVisited: 0
    requiredFlags:
    - pixel.rumor.heard
    blockedFlags: []
    requiredVisits: []
    grantFlags:
    - pixel.route.unlocked
    dialogue:
    - presentationCue: 
      speaker: "Capit\xE1n Turbo"
      text: Veo que ya tienes algo en mente.
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: "Me hablaron de problemas en el Reino del P\xEDxel. Quiero ir all\xED."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: "Capit\xE1n Turbo"
      text: "Conozco la ruta. No te f\xEDes de las tuber\xEDas: algunas tienen visitas."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: GAMERBOY
      text: "Claro. Hasta las tuber\xEDas tienen m\xE1s vida social que yo."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
    - presentationCue: 
      speaker: "Capit\xE1n Turbo"
      text: "Cuando est\xE9s listo, elige el reino en Fast Travel Station. Podr\xE1s
        regresar a Digital Kingdom desde el men\xFA de pausa."
      giftId: 
      giftQuantity: 0
      textPanel: 0
      audiovisualCue: 0
      corruption: 0
      writingSpeed: 0
      pauseBefore: 0
      recoverySeconds: 0
      characterChance: -1
      flickerStrength: -1
      interruptAfterCharacters: 0
